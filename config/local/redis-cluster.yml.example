# Redis集群模式配置示例
spring:
  data:
    redis:
      # 连接超时时间（毫秒）
      timeout: 50000
      password: EFadf_e81.8fea_few_8sXsTx

      # 集群配置 - 取消注释以启用集群模式
      cluster:
        nodes:
          - 10.10.2.187:7001
          - 10.10.2.187:7002
          - 10.10.2.187:7003
        max-redirects: 3

      ###连接池配置###
      jedis:
        pool:
          # 连接池最大连接数（使用负值表示没有限制）
          max-active: 100
          # 连接池最大阻塞等待时间（使用负值表示没有限制）
          max-wait: -1ms
          # 连接池中的最大空闲连接
          max-idle: 30
          # 连接池中的最小空闲连接
          min-idle: 10

# 开启redis监听
redis:
  listener:
    enable: true
